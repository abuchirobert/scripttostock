# ── Required ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (free M0 cluster works fine)
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=scripttostock

# Session cookie signing key — set to a long random string
SECRET_KEY=change-me-to-a-long-random-string

# Admin login (used on the same /login page)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=set-a-strong-password

# ── Optional fallbacks ───────────────────────────────────────────────────────
# API keys can be set in the admin dashboard instead; these are fallbacks.
CLAUDE_API_KEY=
PEXELS_API_KEY=
